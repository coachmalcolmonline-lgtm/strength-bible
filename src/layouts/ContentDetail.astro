---
import BaseLayout from './BaseLayout.astro';
import LevelBlock from '../components/LevelBlock.astro';
const { title, icon, category, levels, sources, backHref, backLabel } = Astro.props;
---
<BaseLayout title={title}>
  <article class="max-w-3xl">
    <a href={backHref} class="text-sm text-slate-500 hover:text-amber-600">&larr; {backLabel}</a>
    <header class="mt-6 mb-12">
      <div class="text-5xl mb-3">{icon}</div>
      <h1 class="text-4xl font-bold tracking-tight">{title}</h1>
      <p class="text-slate-500 mt-2">{category}</p>
    </header>
    {levels.map((level, i) => <LevelBlock level={level} index={i} />)}
    {sources && sources.length > 0 && (
      <section class="mt-16 pt-8 border-t border-slate-200">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Sources</h3>
        <ul class="text-sm text-slate-600 space-y-1">
          {sources.map(source => <li>• {source}</li>)}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
