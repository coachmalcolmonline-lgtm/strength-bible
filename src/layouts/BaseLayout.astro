---
import '../styles/global.css';
interface Props { title: string; }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="The Strength B.I.B.L.E. — Basic Instructions Before Lifting Everything" />
    <title>{title} — The Strength B.I.B.L.E.</title>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">
    <header class="bg-slate-900 text-white px-6 py-4 shadow-md sticky top-0 z-50">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href={base} class="text-xl font-bold tracking-tight hover:text-amber-300 transition">🏋️ The Strength B.I.B.L.E.</a>
        <nav class="hidden md:flex gap-5 text-sm">
          <a href={base} class="hover:text-amber-300 transition">Home</a>
          <a href={`${base}/concepts`} class="hover:text-amber-300 transition">Concepts</a>
          <a href={`${base}/programs`} class="hover:text-amber-300 transition">Programs</a>
          <a href={`${base}/lifts`} class="hover:text-amber-300 transition">Lifts</a>
          <a href={`${base}/bodyweight`} class="hover:text-amber-300 transition">Bodyweight</a>
          <a href={`${base}/mobility`} class="hover:text-amber-300 transition">Mobility</a>
          <a href={`${base}/journal`} class="hover:text-amber-300 transition">Journal</a>
        </nav>
      </div>
    </header>
    <main class="flex-1 max-w-5xl mx-auto px-6 py-12 w-full">
      <slot />
    </main>
    <footer class="border-t border-slate-200 px-6 py-8 text-sm text-slate-500">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <span>The Strength B.I.B.L.E. — Basic Instructions Before Lifting Everything</span>
        <a href="#" class="hover:text-amber-600">↑ Back to top</a>
      </div>
    </footer>
  </body>
</html>
