---
import CFU from './CFU.astro';
const { level, index, slug } = Astro.props;
const levelNumber = level.level ?? index + 1;
const levelNames = { 1: '8th Grade', 2: 'High School Senior', 3: 'College', 4: 'PhD / Scientific Depth' };
---
<section class="mb-12" id={`level-${levelNumber}`}>
  <div class="flex items-center gap-3 mb-4">
    <span class="px-3 py-1 bg-slate-900 text-white text-xs font-bold uppercase tracking-wider rounded-full">Level {levelNumber}</span>
    <span class="text-sm text-slate-500">{levelNames[levelNumber]}</span>
  </div>
  <h2 class="text-2xl font-semibold mb-4">{level.title}</h2>
  <div class="prose prose-slate max-w-none whitespace-pre-line text-slate-700 leading-relaxed mb-6">{level.body}</div>
  {level.cfu && <CFU question={level.cfu.question} options={level.cfu.options} correctIndex={level.cfu.correct_index} slug={slug} level={levelNumber} />}
  {level.stories && level.stories.length > 0 && (
    <div class="mt-6 flex flex-wrap gap-3">
      {level.stories.map((story) => (
        <a href={`${import.meta.env.BASE_URL}/stories/${story.id}`} class="story-link inline-flex items-center gap-2 px-3 py-2 bg-slate-100 hover:bg-slate-200 rounded-md text-sm text-slate-700 transition" data-story-id={story.id}>
          <span>{story.icon}</span>
          <span>{story.title}</span>
          <span class="story-badge hidden text-xs px-1.5 py-0.5 bg-amber-200 text-amber-900 rounded font-medium">revisit</span>
        </a>
      ))}
    </div>
  )}
</section>
<script>
  const PREFIX = 'bible:';
  const SIX_WEEKS_MS = 42 * 24 * 60 * 60 * 1000;

  function getStories() {
    try {
      const raw = localStorage.getItem(PREFIX + 'stories');
      return raw ? JSON.parse(raw) : [];
    } catch { return []; }
  }

  function markOpened(id) {
    const stories = getStories();
    if (!stories.find((s) => s.id === id)) {
      stories.push({ id, date: new Date().toISOString() });
      localStorage.setItem(PREFIX + 'stories', JSON.stringify(stories));
    }
  }

  function paintBadges() {
    const stories = getStories();
    document.querySelectorAll('.story-link').forEach((link) => {
      const id = link.dataset.storyId || '';
      const record = stories.find((s) => s.id === id);
      const badge = link.querySelector('.story-badge');
      if (!badge) return;
      if (record) {
        const age = Date.now() - new Date(record.date).getTime();
        if (age > SIX_WEEKS_MS) {
          badge.classList.remove('hidden');
        }
      }
    });
  }

  document.addEventListener('click', (e) => {
    const link = e.target.closest('.story-link');
    if (!link) return;
    const id = link.dataset.storyId;
    if (!id) return;
    markOpened(id);
  });

  paintBadges();
</script>
