---
interface Video {
  title: string;
  url: string;
  description?: string;
}
interface Props {
  videos?: Video[];
}
const { videos } = Astro.props;
---

{videos && videos.length > 0 && (
  <section class="concept-videos mt-16 pt-8 border-t border-slate-200">
    <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-4">
      🎥 Watch &amp; Learn
    </h3>
    <div class="grid gap-3">
      {videos.map((video) => (
        <a
          href={video.url}
          target="_blank"
          rel="noopener noreferrer"
          class="video-card block p-4 bg-slate-50 hover:bg-amber-50 border border-slate-200 hover:border-amber-300 rounded-lg transition group"
        >
          <div class="flex items-start gap-3">
            <span class="text-2xl flex-shrink-0">▶</span>
            <div class="flex-1 min-w-0">
              <div class="font-medium text-slate-900 group-hover:text-amber-700 transition">
                {video.title}
              </div>
              {video.description && (
                <div class="text-sm text-slate-600 mt-1">{video.description}</div>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
